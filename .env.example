# ---------------------------------------------------------------------------
# AutoPilot Airlines — environment template
#
# Copy this file to .env.dev and fill in the values marked <CHANGE ME>.
#
#   cp .env.example .env.dev
#
# .env.dev is git-ignored. Do NOT commit real credentials.
# ---------------------------------------------------------------------------

# --- Datastores (hostnames are the docker-compose service names) -----------
# These defaults work as-is when running via `docker compose up`.
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@postgres:5432/autopilot
REDIS_URL=redis://redis:6379

# --- Auth / JWT ------------------------------------------------------------
# Change JWT_SECRET to a random high-entropy string before any shared deployment.
JWT_SECRET=dev-local-change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8760

# --- CORS ------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- LLM provider ----------------------------------------------------------
# Pick ONE of the two options below. Leave the other block empty / commented.

# Option A: OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Option B: AWS Bedrock (set AWS_REGION + AWS_ACCESS_KEY_ID to enable Bedrock)
# Populate the three credential fields via: ./refresh-aws-creds.sh <profile>
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514

# --- Security / behaviour toggles (all optional — defaults are permissive) -
# These match the defaults in backend/src/config.py and are intentionally
# open for local testing. Tighten them for any shared or internet-facing run.
INPUT_SANITIZATION=none
PII_REDACTION=false
RATE_LIMIT_ENABLED=false
ERROR_DETAIL_LEVEL=full
DEBUG_TOOLS_ENABLED=true

OAUTH_REQUIRE_STATE=false
OAUTH_ALLOW_IMPLICIT=true

MCP_AUTH_REQUIRED=false
MCP_TOOL_SCOPE_CHECK=false

AGENT_MAX_ITERATIONS=100
AGENT_TOOL_SCOPE_CHECK=false
